{
  "name": "upload-server",
  "version": "1.0.0",
  "description": "Dedicated file uploading microservice using Multer and Express",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec npx tsx src/server.ts",
    "start": "npx tsx src/server.ts",
    "build": "tsc",
    "test:upload": "npx tsx test-client.ts"
